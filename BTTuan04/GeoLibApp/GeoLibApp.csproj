<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeoLib\GeoLib.csproj" />
  </ItemGroup>

  <!-- Tham chiếu trực tiếp tệp GeoLib.dll (không dùng ProjectReference) -->
  <ItemGroup>
    <Reference Include="GeoLib">
      <HintPath>..\GeoLib\bin\$(Configuration)\net10.0\GeoLib.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
